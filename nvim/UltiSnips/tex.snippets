# Many of these are EXTREMELY shamelessly taken from
# https://castel.dev/post/lecture-notes-1/
# and
# https://github.com/gillescastel/latex-snippets/blob/master/tex.snippets


# Keep our latex preamble in a separate file
extends tex-template

priority 1000
snippet ... "ldots" iA
\ldots
endsnippet

#environments {{{

snippet beg "begin{} / end{}" bA
\begin{$1}
	$0
\end{$1}
endsnippet


snippet ali "align*" bA
\begin{align*}
	${1:${VISUAL}}
\end{align*}
endsnippet


snippet enum "enumerate" bA
\begin{enumerate}
	\item $0
\end{enumerate}
endsnippet


snippet sect "section" b
\section{$1}\label{sect:$2}
	$0
endsnippet


snippet subsect "subsection" b
\subsection{$1}\label{subsect:$2}
	$0
endsnippet


snippet defn "definition" b
\begin{defn}\label{defn:$1}
	$0
\end{defn}
endsnippet


snippet thm "theorem" b
\begin{thm}\label{thm:$1}
	$0
\end{thm}
endsnippet


snippet proof "proof" b
\begin{proof}
	$0
\end{proof}
endsnippet

snippet figpic "Figure with includegraphics" b
\begin{figure}[${1:htbp}]
	\centering
	\includegraphics[width=${2:0.8}\linewidth]{${3:filename}}
	\caption{${4:caption}}
	\label{fig:${5:$3}}
\end{figure}
$0
endsnippet

snippet fig "Figure around arbitrary content" b
\begin{figure}[${1:htbp}]
	\centering
	${2:${VISUAL}}
	\caption{${3:caption}}
	\label{fig:${4:label}}
\end{figure}
$0
endsnippet

#}}}
